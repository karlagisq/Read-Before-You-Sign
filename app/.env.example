# Devnet is the right default for the hackathon.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: without this the app uses the deterministic template explanation.
# With it, the plain-English blurb is generated from the structured findings.
ANTHROPIC_API_KEY=

# On-chain scam-registry program ID (from `anchor keys list` in programs/).
# Leave empty to skip the blocklist check.
REGISTRY_PROGRAM_ID=
