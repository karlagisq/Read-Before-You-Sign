# Devnet is the right default for the hackathon.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: without this the app uses the deterministic template explanation.
# With it, the plain-English blurb is generated from the structured findings.
ANTHROPIC_API_KEY=

# On-chain scam-registry program ID (from `anchor keys list` in programs/).
# Leave empty to skip the blocklist check.
REGISTRY_PROGRAM_ID=

# Trade (Sandwich Guard). Server-side only; never commit a real key.
# Free key at https://dashboard.helius.dev. Without it, /trade runs on demo data.
HELIUS_API_KEY=
# mainnet (default) or devnet. Jupiter routes only exist on mainnet.
HELIUS_CLUSTER=mainnet
# Optional: RPC the wallet adapter uses in the browser (public, no key).
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
